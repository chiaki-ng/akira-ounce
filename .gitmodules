[submodule "library/borealis"]
	path = library/borealis
	url = https://github.com/xlanor/ouncelibs.git
	branch = borealis
[submodule "library/tomlplusplus"]
	path = library/tomlplusplus
	url = https://github.com/marzer/tomlplusplus.git
[submodule "library/switch-wireguard"]
	path = library/switch-wireguard
	url = https://github.com/xlanor/ouncelibs.git
	branch = switch-wireguard
[submodule "library/lwip"]
	path = library/lwip
	url = https://github.com/lwip-tcpip/lwip.git
[submodule "library/libchiaki-core"]
	path = library/libchiaki-core
	url = https://github.com/chiaki-ng/chiaki-ng-core.git
[submodule "library/native-deps"]
	path = library/native-deps
	url = https://github.com/xlanor/ouncelibs.git
	branch = native-deps
[submodule "library/sdl2"]
	path = library/sdl2
	url = https://github.com/xlanor/ouncelibs.git
	branch = sdl2
	shallow = true
